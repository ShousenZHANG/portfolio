# The CSP in vercel.json pins a sha256 of the inline JSON-LD block in
# index.html, so that file's bytes must not change between machines. This repo
# is developed on Windows with core.autocrlf=true, which would rewrite it to
# CRLF on any fresh checkout, break the digest, and make Chrome silently drop
# the structured data. Pin LF for everything text.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.mp4 binary
*.woff2 binary
*.pdf binary
